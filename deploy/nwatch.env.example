# nwatch 环境变量示例。生产凭据通过环境变量注入，不写入配置文件。
# 安装脚本会在目标不存在时复制此文件；已存在时保留。

# 运行环境：dev 或 pro。生产默认 pro。
APP_PROFILE=pro

# 管理员初始密码。首次启动创建管理员时使用；之后在管理台修改。
APP_ADMIN_PASSWORD=change-me

# JWT 密钥。留空时自动生成并保存到数据目录。
# APP_JWT_SECRET=

# 网络数据库连接串（使用 mysql/postgres/sqlserver 时必填）。
# APP_DATABASE_DSN=

# SMTP 邮件通道。
# APP_SMTP_ENABLED=true
# APP_SMTP_HOST=smtp.example.com
# APP_SMTP_PORT=587
# APP_SMTP_USERNAME=
# APP_SMTP_PASSWORD=
# APP_SMTP_FROM=nwatch@example.com
# APP_SMTP_TO=ops@example.com
# APP_SMTP_ENCRYPTION=starttls

# 管理台里的可选能力开关。
# APP_SHELL_ENABLED=true
# APP_SERVICE_ENABLED=true
# APP_DOCKER_ENABLED=true
# APP_KUBERNETES_ENABLED=true
# APP_KUBE_CONTEXT=
# APP_KUBECONFIG=

# 兼容别名（已登记的旧名称，优先级低于 APP_*）：
# NMONITOR_PASSWORD、NMONITOR_JWT_SECRET、NMONITOR_SMTP_*、NMONITOR_SHELL_ENABLED 等。
